# ============================================================
#  ELASI — Next.js (frontend) environment template
# ============================================================
#
#  IMPORTANT: Next.js reads env files from THIS directory
#  (frontend/), never from the repository root. The repository-root
#  .env is read by Django only. Copy this file to frontend/.env.local
#  and adjust it there.


# ------------------------------------------------------------
# Server-only: Django origin
# ------------------------------------------------------------
#
# Used by Next.js for React Server Component data fetching and as the
# target of the /api/v1 and /media rewrites. It has no NEXT_PUBLIC_
# prefix, so it is never exposed to the browser bundle.

INTERNAL_API_ORIGIN=http://127.0.0.1:8000


# ------------------------------------------------------------
# Browser-side API base — normally left UNSET
# ------------------------------------------------------------
#
# Recommended (default): leave this unset. The browser then calls the
# relative path /api/v1 on the frontend origin, Next.js proxies it to
# Django, and the session + CSRF cookies stay FIRST-PARTY. This is what
# makes OTP login work regardless of localhost / 127.0.0.1 / port
# differences, and it needs no CORS at all.
#
# Only set an absolute URL when the API really must live on another
# origin. Then all of the following must hold, or login breaks with
# "CSRF Failed: CSRF cookie not set.":
#   * the hostname must match the site hostname (localhost with
#     localhost — never localhost with 127.0.0.1; different ports are
#     fine), because SameSite=Lax cookies are dropped cross-site;
#   * the site origin is listed in the backend's CORS_ALLOWED_ORIGINS;
#   * the site origin is listed in the backend's CSRF_TRUSTED_ORIGINS.
#
# NEXT_PUBLIC_API_BASE_URL=/api/v1


# ------------------------------------------------------------
# Public site URL (metadata, canonical URLs, sitemap)
# ------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000
