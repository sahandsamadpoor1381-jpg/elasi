# ELASI storefront environment template.
# Next.js reads this file from frontend/, not from the repository root.
# Copy it to frontend/.env.local and restart Next.js after editing.

# Server-only Django origin shared by src/proxy.ts and server-side fetches.
# Use scheme + host + optional port only; do not append /api/v1 or /media.
INTERNAL_API_ORIGIN=http://127.0.0.1:8000

# Public storefront origin used for metadata, canonical URLs, and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Do NOT set NEXT_PUBLIC_API_BASE_URL to a Django URL. Browser requests
# must stay relative to the storefront and pass through src/proxy.ts so
# session/CSRF cookies remain first-party. An old absolute value now fails
# loudly instead of bypassing the proxy.
