# ============================================
# ELASI — Git Ignore
# ============================================

# --------------------------------------------
# Environment variables / Secrets
# --------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Keep the safe template in Git
!.env.example


# --------------------------------------------
# Frontend — Node.js / Next.js
# --------------------------------------------
node_modules/
frontend/node_modules/

.next/
frontend/.next/

out/
frontend/out/

dist/
frontend/dist/

coverage/
frontend/coverage/

*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# --------------------------------------------
# Backend — Python / Django
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/

backend/.venv/
backend/venv/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

backend/staticfiles/
backend/media/

db.sqlite3
db.sqlite3-journal


# --------------------------------------------
# Logs
# --------------------------------------------
*.log
logs/


# --------------------------------------------
# Operating System
# --------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini


# --------------------------------------------
# IDE / Editors
# --------------------------------------------
.idea/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


# --------------------------------------------
# Temporary files
# --------------------------------------------
*.tmp
*.temp
*.swp
*.swo
~$*