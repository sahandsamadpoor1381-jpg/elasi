# ELASI - Git attributes

# Normalize text files in the repository
* text=auto

# Source code and configuration use LF
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf

*.py      text eol=lf

*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf

*.env.example text eol=lf
.gitignore     text eol=lf

# Shell scripts use LF
*.sh      text eol=lf

# Windows-native scripts keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files must never be modified by line-ending normalization
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.avif    binary
*.ico     binary
*.svg     text eol=lf
*.pdf     binary

*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary