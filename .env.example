# ============================================================
#  ELASI - Environment Variables Template
# ============================================================
# This file contains variable names and safe development
# examples only. Never place real production secrets here.


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DB_NAME=elasi
DB_USER=elasi
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432


# ------------------------------------------------------------
# Django Backend
# ------------------------------------------------------------

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# Next.js Frontend
# ------------------------------------------------------------

# IMPORTANT (cookie topology):
# Session and CSRF cookies are issued by the Django API with
# SameSite=Lax. Browsers only send those cookies on requests the
# browser considers "same site". Keep the frontend and the API on
# the SAME HOST (different ports are fine) in development — e.g.
# http://localhost:3000 and http://localhost:8000 — or place both
# behind one origin/reverse proxy in production. Mixing localhost
# with 127.0.0.1 makes the two origins cross-site and silently
# breaks login sessions and CSRF.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000


OTP_SMS_BACKEND=apps.accounts.sms.ConsoleOTPBackend
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_WINDOW_SECONDS=900
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCK_SECONDS=900

CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000