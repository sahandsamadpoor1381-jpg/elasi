# ============================================================
#  ELASI - Environment Variables Template
# ============================================================
# This file contains variable names and safe development
# examples only. Never place real production secrets here.


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DB_NAME=elasi
DB_USER=elasi
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432


# ------------------------------------------------------------
# Django Backend
# ------------------------------------------------------------

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Origins Django's CSRF Origin check accepts. In development the
# configured CORS_ALLOWED_ORIGINS are trusted automatically as well
# (config/settings/development.py); production keeps this list
# explicit and must include the real storefront origin(s).


# ------------------------------------------------------------
# Next.js Frontend — NOT read from this file
# ------------------------------------------------------------
#
# Next.js loads env files from the frontend/ directory only. This
# root .env is read by Django. Configure the frontend in
# frontend/.env.local (template: frontend/.env.example).
#
# Cookie topology (why the defaults are what they are):
# Session and CSRF cookies are issued by Django with SameSite=Lax.
# The browser must therefore treat the API as same-site with the
# storefront. The storefront defaults to calling the relative path
# /api/v1, which Next.js proxies to Django, so cookies are always
# first-party and login cannot break because of a localhost vs
# 127.0.0.1 (or port) mismatch. Keep that default unless you have a
# specific reason to serve the API from another origin — and then
# match hostnames exactly and list the site origin in both
# CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS below.


OTP_SMS_BACKEND=apps.accounts.sms.ConsoleOTPBackend
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_WINDOW_SECONDS=900
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCK_SECONDS=900

CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000