# ============================================================
#  ELASI - Environment Variables Template
# ============================================================
# This file contains variable names and safe development
# examples only. Never place real production secrets here.


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DB_NAME=elasi
DB_USER=elasi
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432


# ------------------------------------------------------------
# Django Backend
# ------------------------------------------------------------

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# Next.js Frontend
# ------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
